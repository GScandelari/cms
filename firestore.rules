rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Posts and everything else still go exclusively through the CMS API
    // (Admin SDK, bypasses these rules entirely) — deny by default.
    match /{document=**} {
      allow read, write: if false;
    }

    // Single-session-per-device: cms-admin's client SDK reads/writes its
    // own session marker directly (no backend involved). A user can only
    // ever touch their own uid's document, never anyone else's.
    match /sessions/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
