PORT=3000
FIREBASE_PROJECT_ID=your-project-id
# Paste your Firebase service account JSON as a single-line string:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Required. Sent as the x-api-key header on POST/PUT/DELETE requests to /posts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CMS_API_KEY=

# Optional. Fine-grained GitHub PAT used to trigger a site rebuild on publish.
# GITHUB_DISPATCH_TOKEN=

# Optional. "owner/repo" to send the rebuild repository_dispatch event to.
# Defaults to GScandelari/website-gscandelari if unset — only needed when
# reusing this CMS for a different site.
# GITHUB_DISPATCH_REPO=

# Optional. Firebase Storage bucket used for image uploads (see POST /uploads).
# Defaults to gscandelari-cms.firebasestorage.app if unset — only needed when
# reusing this CMS for a different site/project.
# FIREBASE_STORAGE_BUCKET=

# Required for POST /translate. An Anthropic API key (console.anthropic.com).
# ANTHROPIC_API_KEY=
